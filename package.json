{
  "name": "braille-plate-precheck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "电梯与楼层导向铭牌触觉版（盲文）压点前纯浏览器预检页",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@playwright/test": "1.48.0",
    "@types/node": "^20.16.11",
    "@vitejs/plugin-vue": "^5.1.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "vue-tsc": "^2.1.6"
  }
}
